# Copy to tests/.env. Environment variables take precedence over this file.
# The database must be a dedicated one: every run drops and recreates its wptests_ tables.
WP_TESTS_DB_NAME=eastproperty_tests
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASSWORD=root

# Host, host:port or localhost:/path/to/mysqld.sock.
# Local by WP Engine keeps the socket under the site id:
# WP_TESTS_DB_HOST="localhost:/Users/<you>/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock"
WP_TESTS_DB_HOST=localhost

# WordPress root, when the theme is not inside wp-content/themes of the install to test against.
# WP_CORE_DIR=/path/to/wordpress

# Polylang build to load: polylang-pro/polylang.php (default when present) or polylang/polylang.php.
# WP_TESTS_POLYLANG=polylang/polylang.php
